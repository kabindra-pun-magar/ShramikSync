generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// ENUMS
// ========================================

enum CandidateStatus {
  REGISTERED
  SCREENING
  INTERVIEW
  SELECTED
  REJECTED
  PLACED
}

enum EmployerStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DemandLetterStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
  COMPLETED
}

enum DocumentType {
  PASSPORT
  CITIZENSHIP
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  MEDICAL_REPORT
  POLICE_CLEARANCE
  CONTRACT
  VISA
  OTHER
}

// ========================================
// USER
// ========================================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates    Candidate[]
  employers     Employer[]
  demandLetters DemandLetter[]
}

// ========================================
// CANDIDATE
// ========================================

model Candidate {
  id Int @id @default(autoincrement())

  fullName String
  email    String?
  phone    String?

  dateOfBirth DateTime?
  gender      String?

  nationality String?
  address     String?

  passportNumber String?
  passportExpiry DateTime?

  education  String?
  experience String?
  skills     String?

  status CandidateStatus @default(REGISTERED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========================================
  // OWNERSHIP
  // ========================================

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // ========================================
  // DEMAND LETTER ASSIGNMENTS
  // ========================================

  demandLetterAssignments DemandLetterCandidate[]

  // ========================================
  // DOCUMENTS
  // ========================================

  documents Document[]

  // ========================================
  // INDEXES
  // ========================================

  @@index([createdById])
  @@index([status])
  @@index([passportNumber])
}

// ========================================
// DOCUMENT
// ========================================

model Document {
  id Int @id @default(autoincrement())

  // ========================================
  // DOCUMENT INFORMATION
  // ========================================

  name String

  type DocumentType @default(OTHER)

  fileUrl String

  fileName String?

  mimeType String?

  fileSize Int?

  description String?

  // ========================================
  // CANDIDATE RELATION
  // ========================================

  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // ========================================
  // DATES
  // ========================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========================================
  // INDEXES
  // ========================================

  @@index([candidateId])
  @@index([type])
}

// ========================================
// EMPLOYER
// ========================================

model Employer {
  id Int @id @default(autoincrement())

  companyName   String
  contactPerson String?

  email String?
  phone String?

  country String?
  city    String?
  address String?

  industry    String?
  companyType String?

  status EmployerStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========================================
  // OWNERSHIP
  // ========================================

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // ========================================
  // INDEXES
  // ========================================

  @@index([createdById])
  @@index([status])
  @@index([companyName])
}

// ========================================
// DEMAND LETTER
// ========================================

model DemandLetter {
  id Int @id @default(autoincrement())

  // ========================================
  // DEMAND LETTER INFORMATION
  // ========================================

  referenceNumber String @unique

  jobTitle String

  numberOfWorkers Int

  salary String?

  contractDuration String?

  country String
  city    String?

  description String?

  // ========================================
  // STATUS
  // ========================================

  status DemandLetterStatus @default(DRAFT)

  // ========================================
  // DATES
  // ========================================

  issueDate  DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========================================
  // OWNERSHIP
  // ========================================

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // ========================================
  // CANDIDATE ASSIGNMENTS
  // ========================================

  candidateAssignments DemandLetterCandidate[]

  // ========================================
  // INDEXES
  // ========================================

  @@index([createdById])
  @@index([status])
  @@index([country])
  @@index([referenceNumber])
}

// ========================================
// DEMAND LETTER ↔ CANDIDATE
// ========================================

model DemandLetterCandidate {
  id Int @id @default(autoincrement())

  demandLetterId Int
  candidateId    Int

  assignedAt DateTime @default(now())

  // ========================================
  // RELATIONS
  // ========================================

  demandLetter DemandLetter @relation(fields: [demandLetterId], references: [id], onDelete: Cascade)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // ========================================
  // CONSTRAINTS / INDEXES
  // ========================================

  @@unique([demandLetterId, candidateId])
  @@index([demandLetterId])
  @@index([candidateId])
}
